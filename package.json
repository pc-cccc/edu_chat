{
  "name": "edu-chat",
  "version": "0.4.9",
  "description": "Edu_chat：个人聊天项目，非官方产品。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:direct": "node scripts/dev.mjs --direct",
    "demo": "node scripts/dev.mjs --demo",
    "build": "node scripts/build.mjs",
    "build:direct": "node scripts/build.mjs --direct",
    "build:serverless": "node --env-file-if-exists=.env.serverless scripts/build.mjs --serverless",
    "build:android": "node scripts/build.mjs --android",
    "build:android:direct": "node scripts/build.mjs --android --direct",
    "build:android:serverless": "node --env-file-if-exists=.env.serverless scripts/build.mjs --android --serverless",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --import tsx --test tests/*.test.mjs",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src rspack.config.ts",
    "format": "oxfmt --write .",
    "db:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-database.ps1",
    "db:apply": "node scripts/apply-schema.mjs",
    "db:check": "node scripts/apply-schema.mjs --check"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@supabase/supabase-js": "^2.119.0",
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@electric-sql/pglite": "^0.5.16",
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "~20.9.2",
    "fake-indexeddb": "^6.2.8",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
